/**
 * Wrangler config for the dev-drop Worker.
 *
 * IMPORTANT: `wrangler deploy` replaces the Worker's bindings with whatever is
 * in THIS file. Bindings you added in the dashboard (kv, r2) must be listed
 * here as well, or the next deploy removes them.
 *
 * Secrets are NOT here:
 *     npx wrangler secret put CH_PASSWORD
 *     npx wrangler secret put SUPABASE_DB_URL      (only until Hyperdrive exists)
 *     npx wrangler secret put LOGS_TOKEN           (Better Stack source token)
 *
 * SUPABASE_DB_URL must use the SHARED POOLER in session mode:
 *     postgresql://drop_workflow.<project-ref>:<password>@<pooler-host>:5432/postgres
 * The direct host (db.<ref>.supabase.co) is IPv6-only without the IPv4
 * add-on, and a Worker socket will hang on it rather than fail. Hyperdrive is
 * the opposite: give IT the direct string, it pools on Cloudflare's side.
 *
 * The KV namespace `id` below is the namespace UUID, not its name. Get it with:
 *     npx wrangler kv namespace list
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dev-drop",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		// Without this, opening /api/... in a browser returns the SPA shell
		// instead of calling the Worker: a top-level navigation carries
		// Sec-Fetch-Mode: navigate, and for those Cloudflare applies
		// not_found_handling rather than invoking the script. Plain fetch()
		// reached the Worker all along, which is why a browser and a script
		// saw different things for the same URL.
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workflows": [
		{
			"name": "drop-reports-cleanup",
			"binding": "DROP_REPORTS_CLEANUP",
			"class_name": "DropReportsCleanupWorkflow"
		},
		{
			"name": "drop-downloader",
			"binding": "DROP_DOWNLOADER",
			"class_name": "DropDownloaderWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WORKFLOW_STATUS",
				"class_name": "WorkflowStatusDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"WorkflowStatusDO"
			]
		}
	],
	"upload_source_maps": true,
	// Lets every diagnostic report which deployed version answered it, so
	// "is my code live?" stops being a guess.
	"version_metadata": {
		"binding": "CF_VERSION"
	},
	"kv_namespaces": [
		{
			"binding": "kv",
			"id": "0f2019fd0c714603b5c60e6ae8c0f464"
		}
	],
	"r2_buckets": [
		{
			"binding": "r2",
			"bucket_name": "dev-drop"
		}
	],
	"vars": {
		"CH_URL": "https://cu7iy7dd3r.eu-central-1.aws.clickhouse.cloud:8443",
		"CH_USER": "drop_workflow",
		// Better Stack source → Data ingestion → "Ingesting host". Not a secret.
		// The token is:  npx wrangler secret put LOGS_TOKEN
		"LOGS_HOST": "s2753182.eu-central-1a.betterstackdata.com"
	},
	"triggers": {
		"crons": []
	},
	// Postgres, through Hyperdrive: Cloudflare holds the pool and does the TLS
	// handshake with sslmode=verify-full against the uploaded Supabase root CA.
	// The config was validated at creation — Hyperdrive runs a test query then,
	// so credentials, CA and the (IPv6) direct host are all proven.
	//   config: drop-db · origin db.vsqxnmrvvjsgcrudpruy.supabase.co:5432
	"hyperdrive": [
		{
			"binding": "DROP_DB",
			"id": "df29c50286574600a5f37d7c2490589c"
		}
	]
}