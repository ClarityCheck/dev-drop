/**
 * Wrangler config for dev-drop-check-ch.
 *
 * IMPORTANT: `wrangler deploy` replaces the Worker's bindings with whatever is
 * in THIS file. Bindings you added in the dashboard (kv, r2) must be listed
 * here as well, or the next deploy removes them.
 *
 * CH_PASSWORD is NOT here — it is a secret:
 *     npx wrangler secret put CH_PASSWORD
 *
 * The KV namespace `id` below is the namespace UUID, not its name. Get it with:
 *     npx wrangler kv namespace list
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dev-drop-check-ch",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"workflows": [
		{
			"name": "my-workflow",
			"binding": "MY_WORKFLOW",
			"class_name": "MyWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WORKFLOW_STATUS",
				"class_name": "WorkflowStatusDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"WorkflowStatusDO"
			]
		}
	],
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "kv",
			"id": "0f2019fd0c714603b5c60e6ae8c0f464"
		}
	],
	"r2_buckets": [
		{
			"binding": "r2",
			"bucket_name": "dev-drop"
		}
	],
	"vars": {
		"CH_URL": "https://cu7iy7dd3r.eu-central-1.aws.clickhouse.cloud:8443",
		"CH_USER": "drop_workflow"
	},
	"triggers": {
		"crons": []
	}
}
